{
  "author": "Drake Bott",
  "license": "MIT",
  "homepage": "https://github.com/bottd/vite-plugin-norg#README",
  "name": "vite-plugin-norg",
  "version": "4.0.21",
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "description": "A Vite plugin for rendering Norg files",
  "main": "dist/plugin/index.js",
  "types": "dist/plugin/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin/index.js"
    },
    "./svelte": {
      "types": "./dist/plugin/types/svelte.d.ts"
    },
    "./react": {
      "types": "./dist/plugin/types/react.d.ts"
    },
    "./vue": {
      "types": "./dist/plugin/types/vue.d.ts"
    },
    "./html": {
      "types": "./dist/plugin/types/html.d.ts"
    },
    "./metadata": {
      "types": "./dist/plugin/types/metadata.d.ts"
    }
  },
  "files": [
    "dist",
    "!dist/napi/*.node"
  ],
  "napi": {
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl"
    ]
  },
  "scripts": {
    "build": "npm run build:napi && npm run build:js",
    "build:napi": "napi build --release --platform --esm --output-dir dist/napi/",
    "build:js": "vite build",
    "clean": "rimraf dist target",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "vite",
    "plugin",
    "norg",
    "neorg",
    "wasm",
    "napi",
    "rust",
    "svelte",
    "react",
    "vue"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "svelte": "^5.0.0",
    "vite": "^8.0.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "dedent": "1.7.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@napi-rs/cli": "3.9.0",
    "@rollup/plugin-typescript": "12.3.0",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/npm": "13.1.5",
    "@types/node": "25.9.5",
    "@types/react": "19.2.18",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "jiti": "2.7.0",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "rimraf": "6.1.3",
    "semantic-release": "25.0.9",
    "svelte": "5.57.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vite-plugin-dts": "5.1.0",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bottd/vite-plugin-norg.git"
  },
  "optionalDependencies": {
    "vite-plugin-norg-darwin-x64": "4.0.21",
    "vite-plugin-norg-darwin-arm64": "4.0.21",
    "vite-plugin-norg-linux-x64-gnu": "4.0.21",
    "vite-plugin-norg-linux-arm64-gnu": "4.0.21",
    "vite-plugin-norg-linux-x64-musl": "4.0.21",
    "vite-plugin-norg-linux-arm64-musl": "4.0.21"
  }
}