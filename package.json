{
  "author": "Drake Bott",
  "license": "MIT",
  "homepage": "https://github.com/bottd/vite-plugin-norg#README",
  "name": "vite-plugin-norg",
  "version": "4.1.0",
  "packageManager": "pnpm@11.28.12",
  "type": "module",
  "description": "A Vite plugin for rendering Norg files",
  "main": "dist/plugin/index.js",
  "types": "dist/plugin/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin/index.js"
    },
    "./svelte": {
      "types": "./dist/plugin/types/svelte.d.ts"
    },
    "./react": {
      "types": "./dist/plugin/types/react.d.ts"
    },
    "./vue": {
      "types": "./dist/plugin/types/vue.d.ts"
    },
    "./html": {
      "types": "./dist/plugin/types/html.d.ts"
    },
    "./metadata": {
      "types": "./dist/plugin/types/metadata.d.ts"
    }
  },
  "files": [
    "dist",
    "!dist/napi/*.node"
  ],
  "napi": {
    "constEnum": false,
    "runtimeStringEnum": true,
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl"
    ]
  },
  "scripts": {
    "build": "npm run build:napi && npm run build:js",
    "build:napi": "napi build --release --platform --esm --output-dir dist/napi/",
    "build:js": "vite build",
    "clean": "rimraf dist target",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "treefmt",
    "format:check": "treefmt --ci",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "vite",
    "plugin",
    "norg",
    "neorg",
    "wasm",
    "napi",
    "rust",
    "svelte",
    "react",
    "vue"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "svelte": "^5.0.0",
    "vite": "^8.0.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "dedent": "1.7.2"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.12",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/npm": "13.2.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@typescript/typescript6": "6.0.2",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "react": "19.3.1",
    "rimraf": "6.1.4",
    "semantic-release": "25.0.9",
    "svelte": "5.57.3",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-dts": "5.1.2",
    "vitest": "5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bottd/vite-plugin-norg.git"
  },
  "optionalDependencies": {
    "vite-plugin-norg-darwin-x64": "4.1.0",
    "vite-plugin-norg-darwin-arm64": "4.1.0",
    "vite-plugin-norg-linux-x64-gnu": "4.1.0",
    "vite-plugin-norg-linux-arm64-gnu": "4.1.0",
    "vite-plugin-norg-linux-x64-musl": "4.1.0",
    "vite-plugin-norg-linux-arm64-musl": "4.1.0"
  }
}